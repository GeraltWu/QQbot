# 配置 NoneBot2 监听的地址和端口
HOST=
PORT=

# 加载 OneBot v11 适配器
COMMAND_START=["/"]

ONEBOT_ACCESS_TOKEN=

ENVIRONMENT=dev
DRIVER=~fastapi
LOCALSTORE_USE_CWD=true

APEX_API_BASE_URL=https://api.mozambiquehe.re
APEX_API_KEY=

